    "ssh2": "^1.17.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.25.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
