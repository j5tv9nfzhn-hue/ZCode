{
  "name": "zcode-cli",
  "version": "0.16.9",
  "private": true,
  "description": "ZCode Agent runtime: ZCode Protocol server, plugin host, dynamic workflow runtime and tools, consumed by the desktop app and remote workspaces.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm registry:check && turbo run typecheck",
    "clean": "turbo run clean",
    "dev": "pnpm --filter @zcode/cli dev",
    "format": "oxfmt --write package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "format:check": "oxfmt --check package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "lint": "turbo run lint",
    "lint:count": "node scripts/count-ts-lines.mjs",
    "lint:fix": "turbo run lint:fix",
    "prompt-trajectory:model-io": "pnpm --filter @zcode/prompt-trajectory model-io --",
    "prompt-trajectory:prompt": "pnpm --filter @zcode/prompt-trajectory record:prompt --",
    "registry:check": "node scripts/generate-bash-command-registry.mjs --check",
    "registry:generate": "node scripts/generate-bash-command-registry.mjs",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "proxy-agent": "^8.0.1"
  },
  "devDependencies": {
    "@withfig/autocomplete": "2.692.3",
    "@types/node": "^24.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.20.0",
    "turbo": "^2.4.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "pnpm@10.33.2"
}
